{
  "name": "resuelve-proyecto-final",
  "version": "2.0.0",
  "description": "API Backend Node.js/Express con MongoDB Atlas y Notificaciones Webhook en Tiempo Real",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
