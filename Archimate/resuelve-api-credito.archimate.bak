    <element xsi:type="archimate:Goal" name="Automatizar la aprobación de crédito de bajo/mediano monto" id="id-1002"/>
    <element xsi:type="archimate:Outcome" name="95% de solicitudes resueltas en menos de 3s; 60% sin consultar buró externo; soporte a 5000 solicitudes concurrentes" id="id-1003"/>
  </folder>

