PORT=8091
NODE_ENV=development
ESCENARIO_INICIAL=NORMAL

# Controla el retraso (en milisegundos) del escenario LATENCIA_ALTA.
# Puede reducirse en pruebas para evitar suites lentas.
LATENCIA_MS=5000

# Ruta al contrato OpenAPI servido en /docs y /openapi.yaml. Por defecto se lee
# ../../contracts/spec5-buro-simulado.yaml (sin copia del YAML en el servicio).
# En Docker, contracts/ se monta en /contracts.
# CONTRATO_OPENAPI_PATH=/contracts/spec5-buro-simulado.yaml
