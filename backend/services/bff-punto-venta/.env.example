PORT=8081
NODE_ENV=development
EVALUACION_CORE_URL=http://evaluacion-core:8090
# Tiempo maximo (ms) de espera a evaluacion-core antes de responder 504 EVALUACION_TIMEOUT (> 0)
CORE_TIMEOUT_MS=5000
# Tiempo de vida (ms) de un ResultadoPos en la cache de reconsultas (> 0; 900000 = 15 min)
CACHE_TTL_MS=900000
# Capacidad maxima de la cache de reconsultas; al superarla se descarta la entrada menos usada (entero > 0)
CACHE_MAX_ENTRADAS=1000
