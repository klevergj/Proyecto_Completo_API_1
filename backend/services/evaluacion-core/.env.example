PORT=8090
NODE_ENV=development
BURO_SIMULADO_URL=http://buro-simulado:8091
REPOSITORIO_INTERNO_URL=http://repositorio-interno:8092
AUDITORIA_SERVICE_URL=http://auditoria:8095
# Umbrales del motor de reglas (leidos por src/config/reglasConfig.js)
# Score minimo de buro por debajo del cual se rechaza (rango valido 300-850)
UMBRAL_SCORE_MINIMO=600
# Score de buro a partir del cual se considera bueno para cliente nuevo (rango valido 300-850)
UMBRAL_SCORE_BUENO=700
# Porcentaje maximo tolerado de relacion cuota mensual / ingreso mensual (> 0)
PORCENTAJE_CUOTA_INGRESO=0.35
# Decision al superar el porcentaje cuota/ingreso: RECHAZADO | REVISION_MANUAL
MODO_CUOTA_INGRESO=REVISION_MANUAL
# Monto maximo para aprobacion automatica de clientes con historial limpio (> 0)
TOPE_MONTO_APROBACION_AUTOMATICA=500
