PORT=8082
NODE_ENV=development
AUDITORIA_SERVICE_URL=http://auditoria:8095
# Tiempo maximo (ms) de espera al Servicio de Auditoria antes de responder 504 (> 0)
AUDITORIA_TIMEOUT_MS=3000
# Paginacion del listado (enteros > 0; defecto <= maximo). Deben coincidir con los de auditoria.
PAGINA_TAMANO_DEFECTO=20
PAGINA_TAMANO_MAXIMO=100
