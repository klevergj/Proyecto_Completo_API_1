PORT=8080
NODE_ENV=development
# Puerto interno de metricas Prometheus (GET /metrics). No publicarlo hacia los aliados.
METRICS_PORT=9464

# Autenticacion OAuth2. Solo el valor "false" la desactiva (modo temporal hasta
# integrar el Frontend con tokens); sin la variable queda ACTIVA.
AUTH_HABILITADA=false

# OAuth2 (Keycloak, flujo client_credentials). Obligatorias si AUTH_HABILITADA no es "false".
# El emisor es la URL publica del realm (la que aparece en el claim iss del token).
JWT_ISSUER=http://localhost:8180/realms/resuelve
JWT_AUDIENCE=resuelve-api
# JWKS por la red interna (en Docker: http://keycloak:8080/...)
JWKS_URI=http://localhost:8180/realms/resuelve/protocol/openid-connect/certs
JWKS_TIMEOUT_MS=3000

# Destinos y timeouts (mayores que los timeouts internos de cada BFF)
BFF_POS_URL=http://bff-punto-venta:8081
BFF_POS_TIMEOUT_MS=6000
BFF_AUDITORIA_URL=http://bff-auditoria:8082
BFF_AUDITORIA_TIMEOUT_MS=4000

# Rate limiting por client_id
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
