{
  "info": {
    "name": "Resuelve API - Colección de Microservicios",
    "_postman_id": "8a71b4e0-3bf0-4f51-a902-resuelve001",
    "description": "Colección de endpoints para probar los microservicios del sistema de evaluación de crédito Resuelve",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. API Gateway (:8080) /v1",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/health"
          }
        },
        {
          "name": "POST /v1/evaluaciones-credito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.idEvaluacion) pm.collectionVariables.set(\"idEvaluacion\", cuerpo.idEvaluacion);",
                  "pm.test(\"ResultadoPos\", () => pm.expect(cuerpo).to.have.keys([\"idEvaluacion\", \"aprobado\", \"mensajeParaCliente\"]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{gatewayToken}}",
                "description": "Opcional mientras AUTH_HABILITADA=false"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificacion\": \"1720000002\",\n  \"montoSolicitado\": 450,\n  \"plazoMeses\": 12,\n  \"tiendaId\": \"CENTRO-SUR-01\"\n}"
            },
            "url": "{{gatewayUrl}}/v1/evaluaciones-credito"
          }
        },
        {
          "name": "GET /v1/evaluaciones-credito/{id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gatewayToken}}",
                "description": "Opcional mientras AUTH_HABILITADA=false"
              }
            ],
            "url": "{{gatewayUrl}}/v1/evaluaciones-credito/{{idEvaluacion}}"
          }
        },
        {
          "name": "GET /v1/auditoria/evaluaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gatewayToken}}",
                "description": "Opcional mientras AUTH_HABILITADA=false"
              }
            ],
            "url": "{{gatewayUrl}}/v1/auditoria/evaluaciones?page=0&size=10"
          }
        },
        {
          "name": "GET /v1/auditoria/evaluaciones/{id}/detalle",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gatewayToken}}",
                "description": "Opcional mientras AUTH_HABILITADA=false"
              }
            ],
            "url": "{{gatewayUrl}}/v1/auditoria/evaluaciones/{{idEvaluacion}}/detalle"
          }
        }
      ]
    },
